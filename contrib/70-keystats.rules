# Give the logged-in desktop user read access to ONLY the Cornes' main keyboard
# interfaces (Keebart Corne Choc Pro and the older DH747 W-CORNE) (not its "Keyboard" NKRO / Mouse / System Control / Consumer Control
# interfaces, and not any other keyboard). Uses systemd-logind's "uaccess" ACL, so it must sort
# before 73-seat-late.rules — keep the "70-" prefix.
#
# Install:  sudo install -m 644 contrib/70-keystats.rules /etc/udev/rules.d/
#           sudo udevadm control --reload && sudo udevadm trigger --subsystem-match=input
# Then unplug/replug the keyboard (or reboot).
#
# For a different keyboard, add a line with its name (see `keystats devices` or
# `cat /proc/bus/input/devices`).
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Keebart corne_choc_pro", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="DH747 W-CORNE", TAG+="uaccess"
